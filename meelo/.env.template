# Values go into Portainer's stack environment, not into a file in this repo.
# Follow https://github.com/Arthi-chaud/Meelo/blob/main/.env.example for the
# full meaning of each one.

# Meelo release to run. Pin it; read the changelog before bumping.
TAG=v3.13.1

# External URL, no trailing slash. Must match the proxy host.
PUBLIC_URL=https://music.{your.domain}

# Host paths. DATA_DIR is the music library, CONFIG_DIR holds settings.json
# and the illustrations Meelo downloads.
DATA_DIR={/path/to/music/library}
CONFIG_DIR={/path/to/meelo/config}

# Do not change these two — they are the paths *inside* the containers and
# upstream's own .env.example asks you to leave them alone.
INTERNAL_DATA_DIR=/data
INTERNAL_CONFIG_DIR=/config

# 1 allows unauthenticated API requests. 0 is the safer default for an
# instance published on the internet.
ALLOW_ANONYMOUS=0
# Must be 1 until the first admin account exists, then set it to 0 and
# redeploy, or anyone reaching the site can create an account.
ENABLE_USER_REGISTRATION=1

POSTGRES_USER={db_user}
POSTGRES_PASSWORD={db_password}
POSTGRES_DB=meelo

RABBITMQ_USER={mq_user}
RABBITMQ_PASSWORD={mq_password}

# Random strings. JWT_SIGNATURE signs session tokens, MEILI_MASTER_KEY must be
# at least 16 bytes, API_KEYS is a comma-separated list used by scanner and
# matcher to authenticate against the server.
JWT_SIGNATURE={random_string}
MEILI_MASTER_KEY={random_string_min_16_bytes}
API_KEYS={random_string}

# Optional, for the Last.fm scrobbler. Leave unset to disable.
LASTFM_API_KEY=
LASTFM_API_SECRET=
